APP_NAME=SupportFlow AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

API_HOST=127.0.0.1
API_PORT=8000

DATABASE_URL=sqlite:///./data/app.db

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=

VECTOR_STORE_PATH=data/vector_store

AGENT_CONFIDENCE_THRESHOLD=0.85

# Simulated database status only; no email is sent.
AUTO_SEND_ENABLED=false
AUTO_SEND_CONFIDENCE_THRESHOLD=0.90
AUTO_SEND_MIN_RETRIEVAL_SCORE=0.10

BACKEND_URL=http://127.0.0.1:8000

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

DEMO_ADMIN_EMAIL=demo@supportflow.ai
DEMO_ADMIN_PASSWORD=Apex Demo Password
DEMO_COMPANY_NAME=Apex Demo Support